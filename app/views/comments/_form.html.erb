<%= form_with model: [ trip, journal_entry, comment ], local: true, class: "comment-form d-flex gap-2 align-items-end" do |f| %>
  <div class="flex-grow-1">
    <%= f.label :content, "Add a comment", class: "form-label small mb-1" %>
    <%= f.text_area :content,
        rows: 2,
        class: "form-control form-control-sm",
        placeholder: "Share your thoughts about this entry..." %>
  </div>
  <div class="pb-1">
    <%= f.submit "Post", class: "btn btn-primary btn-sm" %>
  </div>
<% end %>
