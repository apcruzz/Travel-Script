<% raise "Journal Entry is nil:" if journal_entry.nil? %>

<div class="journal-entry">

  <!-- Title (clickable only by the owner) -->
  <h4>
    <% if journal_entry.user == Current.user %>
      <%= link_to journal_entry.title,
          trip_journal_entry_path(journal_entry.trip, journal_entry),
          class: "entry-link" %>
    <% else %>
      <%= journal_entry.title %>
    <% end %>
  </h4>

  <!-- Content -->
  <p><%= journal_entry.content %></p>

  <!-- Images -->
  <% if journal_entry.media.attached? %>
    <div class="image-carousel journal-entry-images" data-controller="carousel">
      <button type="button"
          class="nav-btn nav-btn-prev"
          data-carousel-target="nav"
          data-action="carousel#prev">‹</button>
      <div class="image-track" data-carousel-target="track">
        <% journal_entry.media.each do |file| %>
          <div class="carousel-slide" data-carousel-target="slide">
            <% if file.variable? %>
              <% begin %>
                <%= image_tag file.variant(resize_to_fill: [ 1080, 1080 ]).processed, class: "carousel-image" %>
              <% rescue => e %>
                <%= image_tag file, class: "carousel-image", alt: file.filename.to_s %>
              <% end %>
            <% elsif file.content_type.start_with?("video/") %>
              <%= video_tag file, controls: true, class: "carousel-image" %>
            <% else %>
              <%= link_to file.filename.to_s, url_for(file), class: "carousel-attachment-link" %>
            <% end %>
          </div>
        <% end %>
      </div>
      <button type="button"
          class="nav-btn nav-btn-next"
          data-carousel-target="nav"
          data-action="carousel#next">›</button>
      <div class="carousel-dots">
        <% journal_entry.media.each_with_index do |file, index| %>
          <button type="button"
              class="carousel-dot"
              data-carousel-target="dot"
              data-carousel-index="<%= index %>"
              data-action="carousel#jump"></button>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Dates -->
  <p class="journal-entry-date">
    <em>Went at <%= journal_entry.date.strftime("%B %d, %Y") %></em>
  </p>

  <p class="text-muted small">
    Posted by <%= journal_entry.user.name %> on
    <%= journal_entry.created_at.strftime("%B %d, %Y") %>
  </p>
<%# LEARN MORE FROM HERE TO THE BOTTOM and THE JAVASCRIPTS too%>
  <% user_reaction = journal_entry.reactions.find_by(user: Current.user) %>
  <% comments = journal_entry.comments.includes(:user).order(created_at: :asc) %>

  <div class="post-actions" data-controller="post-actions">
    <div class="reaction-summary">
      <% total = journal_entry.reactions.count %>
      <div class="reaction-count-display">
        <div class="reaction-icons">
          <% Reaction::REACTION_TYPES.first(3).each do |emoji| %>
            <% next unless journal_entry.reactions.exists?(reaction_type: emoji) %>
            <span class="reaction-count-icon"><%= emoji %></span>
          <% end %>
        </div>
        <% if user_reaction.present? %>
          <% others = total - 1 %>
          <% if others.positive? %>
            You and <%= pluralize(others, "other") %>
          <% else %>
            You
          <% end %>
        <% else %>
          <%= pluralize(total, "reaction") %>
        <% end %>
      </div>
      <button
          type="button"
          class="comment-count-btn"
          data-post-actions-target="commentButton"
          data-action="post-actions#toggleComments">
        <%= pluralize(comments.size, "comment") %>
      </button>
    </div>

    <div class="action-buttons">
      <div class="like-action"
          data-action="mouseenter->post-actions#showPicker mouseleave->post-actions#scheduleHide">
        <% default_reaction = Reaction::REACTION_TYPES.first %>
        <% if user_reaction.present? %>
          <%= button_to trip_journal_entry_unreact_path(journal_entry.trip, journal_entry),
              method: :delete,
              class: "action-btn like-btn active" do %>
            <i class="bi bi-hand-thumbs-up-fill"></i>
            <span>Like</span>
          <% end %>
        <% else %>
          <%= button_to trip_journal_entry_react_path(journal_entry.trip, journal_entry),
              method: :post,
              params: { reaction_type: default_reaction },
              class: "action-btn like-btn" do %>
            <i class="bi bi-hand-thumbs-up"></i>
            <span>Like</span>
          <% end %>
        <% end %>

        <div class="reaction-picker"
            data-post-actions-target="picker"
            data-action="mouseenter->post-actions#cancelHide mouseleave->post-actions#scheduleHide">
          <% Reaction::REACTION_TYPES.each do |emoji| %>
            <%= button_to trip_journal_entry_react_path(journal_entry.trip, journal_entry),
                method: user_reaction.present? ? :patch : :post,
                params: { reaction_type: emoji },
                class: "reaction-picker-btn #{'active' if user_reaction&.reaction_type == emoji}" do %>
              <span><%= emoji %></span>
            <% end %>
          <% end %>
        </div>
      </div>

      <button
          type="button"
          class="action-btn comment-btn"
          data-post-actions-target="commentButton"
          data-action="post-actions#toggleComments">
        <i class="bi bi-chat"></i>
        <span>Comment</span>
      </button>
    </div>

    <div class="comments-wrapper" data-post-actions-target="comments" hidden>
      <h6 class="text-muted mb-3">Comments (<%= comments.size %>)</h6>

      <% if comments.any? %>
        <%= render comments %>
      <% else %>
        <p class="text-muted small">No comments yet. Be the first to share your thoughts!</p>
      <% end %>

      <% if authenticated? %>
        <div class="mt-3">
          <%= render "comments/form",
              trip: journal_entry.trip,
              journal_entry:,
              comment: Comment.new %>
        </div>
      <% else %>
        <p class="text-muted small mt-3">Log in to post a comment.</p>
      <% end %>
    </div>
  </div>

  <hr>
</div>
